# Copiare in .env.local (mai committare i valori)
SANITY_PROJECT_ID=8yzoe1bm
# Da dove il sito legge i contenuti. Vuoto = dati di prova (fixtures).
#   staging     = anteprime e prove       production = sito pubblico
SANITY_DATASET=
SANITY_API_VERSION=2026-10-01
# Solo se il dataset diventa privato (il sito legge dati pubblici)
SANITY_READ_TOKEN=
# Solo locale, solo per l'importatore (pnpm import:run). Permessi "Editor". Mai in chat.
SANITY_WRITE_TOKEN=
# Dominio definitivo (canonical, sitemap, Open Graph). Vuoto = https://www.tonypignatellistudio.com
PUBLIC_SITE_URL=
# Modulo contatti. In fase di build (variabile pubblica, anche su Cloudflare):
PUBLIC_TURNSTILE_SITE_KEY=
# Segreti del Worker (su Cloudflare: Impostazioni > Variabili e segreti; qui solo per le prove locali):
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
# Destinatario (casella dello studio) e mittente (dominio verificato in Resend).
CONTACT_TO=
CONTACT_FROM=
