---
import { getSiteSettings } from '../lib/content';

/**
 * Modulo contatti (HANDOFF §10): solo tre campi — Nome, Email, Messaggio — più un campo
 * trappola nascosto. L'invio va a `/api/contact` (funzione serverless: Fase 5, dopo la
 * scelta del servizio di posta).
 */
interface Props {
  title: string;
  privacyNote: string;
}
const { title, privacyNote } = Astro.props;
const settings = await getSiteSettings();
---
<div class="panel">
  <h2 class="panel__title">{title}</h2>

  <form class="form" action="/api/contact" method="post" novalidate data-contact-form data-fallback-email={settings.email}>
    <div class="field">
      <label for="contact-name">Nome</label>
      <input
        id="contact-name"
        class="field__control"
        name="name"
        type="text"
        autocomplete="name"
        required
        placeholder="Il tuo nome"
        aria-describedby="contact-name-error"
      />
      <p class="field__error" id="contact-name-error" hidden></p>
    </div>

    <div class="field">
      <label for="contact-email">Email</label>
      <input
        id="contact-email"
        class="field__control"
        name="email"
        type="email"
        autocomplete="email"
        required
        placeholder="nome@azienda.com"
        aria-describedby="contact-email-error"
      />
      <p class="field__error" id="contact-email-error" hidden></p>
    </div>

    <div class="field">
      <label for="contact-message">Messaggio</label>
      <textarea
        id="contact-message"
        class="field__control"
        name="message"
        rows="5"
        required
        placeholder="Raccontaci in due righe cosa hai in mente."
        aria-describedby="contact-message-error"
      ></textarea>
      <p class="field__error" id="contact-message-error" hidden></p>
    </div>

    <!-- Campo trappola per i bot: invisibile e fuori dalla tastiera -->
    <div class="trap" aria-hidden="true">
      <label for="contact-website">Non compilare questo campo</label>
      <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Verifica anti-spam (Cloudflare Turnstile): si aggiunge in Fase 5 insieme all'invio -->

    <button type="submit" class="button" data-submit>Invia richiesta</button>

    <div class="status" role="status" aria-live="polite" data-status hidden></div>

    <p class="note">{privacyNote} <a href="/privacy" class="note__link">Privacy policy</a></p>
  </form>
</div>

<script>
  import { initContactForm } from '../scripts/contact-form';
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(initContactForm);
</script>

<style>
  .panel { background: var(--surface-200); padding: var(--space-6); }
  .panel__title { font-size: var(--fs-body); font-weight: 500; line-height: 1.3; margin-bottom: var(--space-5); }
  .form { display: flex; flex-direction: column; gap: var(--space-4); }

  .field label { display: block; font-size: var(--fs-small); font-weight: 500; margin-bottom: var(--space-1); }
  .field__control {
    display: block;
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--line);
    background: var(--surface-100);
    color: var(--ink);
    font-family: inherit;
    font-size: var(--fs-link);
    line-height: 1.45;
    border-radius: 0;
  }
  .field__control::placeholder { color: var(--ink-soft); opacity: 1; }
  textarea.field__control { resize: vertical; min-height: 140px; }
  .field__control[aria-invalid='true'] { border-color: var(--ink); border-width: 2px; padding: calc(var(--space-3) - 1px); }
  .field__error { margin-top: var(--space-1); font-size: var(--fs-small); font-weight: 500; line-height: 1.4; color: var(--ink); }

  .trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }

  /* L'unico pulsante pieno del sito */
  .button {
    align-self: flex-start;
    min-height: 52px;
    padding: var(--space-3) var(--space-5);
    border: 0;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: inherit;
    font-size: var(--fs-link);
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
  }
  .button[disabled] { opacity: 0.6; cursor: default; }

  .status { font-size: var(--fs-body); line-height: 1.45; }
  .status a { border-bottom: 1px solid currentColor; }
  .note { font-size: var(--fs-meta); line-height: 1.5; color: var(--ink-soft); }
  .note__link { border-bottom: 1px solid currentColor; }

  @media (max-width: 640px) {
    .panel { padding: var(--space-4); }
  }
</style>
