---
import { buildSrcset } from '../lib/image';
import { layoutGallery } from '../lib/gallery';
import type { PhotoData } from '../lib/types';
import Photo from './Photo.astro';

/** Galleria sfalsata con le proporzioni reali delle foto + visore a tutto schermo. */
interface Props {
  photos: PhotoData[];
  /** Testo alternativo di riserva (titolo del progetto). */
  fallbackAlt: string;
}
const { photos, fallbackAlt } = Astro.props;
const items = layoutGallery(photos);
---
<div class="gallery" data-gallery>
  {items.map((item) => {
    const image = buildSrcset(item.photo);
    const alt = item.photo.alt?.trim() || fallbackAlt;
    return (
      <button
        type="button"
        class={`gallery__item gallery__item--${item.orientation}`}
        style={`--col-start: ${item.colStart}; --col-end: ${item.colEnd}; --mt: ${item.marginTop}px; --ratio-m: ${item.mobileRatio}`}
        data-gallery-item
        data-alt={alt}
        data-src={image?.src ?? ''}
        data-srcset={image?.srcset ?? ''}
        data-width={item.photo.width}
        data-height={item.photo.height}
        aria-label={`Apri la foto ${item.index + 1} di ${items.length}`}
      >
        <Photo
          photo={item.photo}
          fallbackAlt={alt}
          loading={item.index < 3 ? 'eager' : 'lazy'}
          sizes="(max-width: 640px) 100vw, (max-width: 1023px) 50vw, 60vw"
        />
      </button>
    );
  })}
</div>

<dialog class="viewer on-dark" aria-label="Galleria fotografica" data-viewer>
  <div class="viewer__bar">
    <span class="meta viewer__count" data-viewer-count aria-live="polite"></span>
    <button type="button" class="viewer__button" data-viewer-close>Chiudi</button>
  </div>
  <div class="viewer__stage" data-viewer-stage>
    <img class="viewer__img" alt="" data-viewer-img hidden />
    <p class="meta viewer__placeholder" data-viewer-placeholder hidden></p>
  </div>
  <button type="button" class="viewer__nav viewer__nav--prev" data-viewer-prev aria-label="Foto precedente">←</button>
  <button type="button" class="viewer__nav viewer__nav--next" data-viewer-next aria-label="Foto successiva">→</button>
</dialog>

<script>
  import { initGallery } from '../scripts/gallery';
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>

<style is:global>
  /* Desktop: griglia a 12 colonne, posizione e scarto da `layoutGallery` */
  .gallery {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-4);
    row-gap: var(--space-6);
    align-items: start;
  }
  .gallery__item {
    grid-column: var(--col-start) / var(--col-end);
    margin-top: var(--mt);
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    text-align: inherit;
  }

  /* Tablet: 2 colonne, orizzontali a tutta larghezza, verticali e quadrate a mezza */
  @media (max-width: 1023px) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gallery__item { grid-column: auto; margin-top: 0; }
    .gallery__item--wide { grid-column: 1 / -1; }
  }

  /* Mobile: 1 colonna; larghezza piena alternata a 88%; le verticali non oltre 4:5 */
  @media (max-width: 640px) {
    .gallery { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-5); }
    .gallery__item { grid-column: 1; }
    .gallery__item .photo { --ratio: var(--ratio-m); }
    .gallery__item:nth-child(3n + 2) { width: 88%; justify-self: end; }
    .gallery__item:nth-child(3n + 3) { width: 88%; justify-self: start; }
  }

  /* Visore a tutto schermo */
  .viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--surface-inverse);
    color: var(--ink-inverse);
    overflow: hidden;
  }
  .viewer:not([open]) { display: none; }
  .viewer__bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--page-pad);
  }
  .viewer__count { color: var(--ink-soft-inverse); }
  .viewer__button {
    min-height: 44px;
    padding: 0 var(--space-3);
    margin-right: calc(var(--space-3) * -1);
    border: 0;
    background: transparent;
    font-size: var(--fs-small);
    cursor: pointer;
  }
  .viewer__stage {
    position: absolute;
    inset: 72px 88px 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .viewer__img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .viewer__placeholder { color: var(--ink-soft-inverse); text-align: center; }
  .viewer__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 56px;
    height: 56px;
    margin-top: -28px;
    border: 0;
    background: transparent;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }
  .viewer__nav--prev { left: var(--space-2); }
  .viewer__nav--next { right: var(--space-2); }
  .viewer__nav:disabled { opacity: 0.25; cursor: default; }
  @media (max-width: 640px) {
    .viewer__stage { inset: 64px 0 80px; }
    .viewer__nav { top: auto; bottom: var(--space-3); margin-top: 0; }
    .viewer__nav--prev { left: var(--page-pad); }
    .viewer__nav--next { right: var(--page-pad); }
  }
</style>
