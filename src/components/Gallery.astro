---
import { buildSrcset } from '../lib/image';
import { layoutMasonryFor, MASONRY_COLUMNS } from '../lib/masonry';
import type { PhotoData } from '../lib/types';
import Photo from './Photo.astro';

/** Galleria a 3 colonne (stile Pinterest) con le proporzioni reali delle foto + visore a tutto schermo. */
interface Props {
  photos: PhotoData[];
  /** Testo alternativo di riserva (titolo del progetto). */
  fallbackAlt: string;
}
const { photos, fallbackAlt } = Astro.props;
const slots = layoutMasonryFor(photos);
const columns = Array.from({ length: MASONRY_COLUMNS }, (_, column) =>
  slots.filter((slot) => slot.column === column).flatMap((slot) => {
    const photo = photos[slot.index];
    return photo ? [{ photo, slot }] : [];
  }),
);
---
<div class="masonry gallery" data-gallery>
  {columns.map((column) => (
    <div class="masonry__column">
      {column.map(({ photo, slot }) => {
        const image = buildSrcset(photo);
        const alt = photo.alt?.trim() || fallbackAlt;
        return (
          <button
            type="button"
            class="gallery__item"
            style={`--ratio: ${slot.ratio}; order: ${slot.index}`}
            data-gallery-item
            data-index={slot.index}
            data-alt={alt}
            data-src={image?.src ?? ''}
            data-srcset={image?.srcset ?? ''}
            data-width={photo.width}
            data-height={photo.height}
            aria-label={`Apri la foto ${slot.index + 1} di ${photos.length}`}
          >
            <Photo
              photo={photo}
              fallbackAlt={alt}
              loading={slot.index < 3 ? 'eager' : 'lazy'}
              sizes="(max-width: 640px) 100vw, 34vw"
            />
          </button>
        );
      })}
    </div>
  ))}
</div>

<dialog class="viewer on-dark" aria-label="Galleria fotografica" data-viewer>
  <div class="viewer__bar">
    <span class="meta viewer__count" data-viewer-count aria-live="polite"></span>
    <button type="button" class="viewer__button" data-viewer-close>Chiudi</button>
  </div>
  <div class="viewer__stage" data-viewer-stage>
    <img class="viewer__img" alt="" data-viewer-img hidden />
    <p class="meta viewer__placeholder" data-viewer-placeholder hidden></p>
  </div>
  <button type="button" class="viewer__nav viewer__nav--prev" data-viewer-prev aria-label="Foto precedente">←</button>
  <button type="button" class="viewer__nav viewer__nav--next" data-viewer-next aria-label="Foto successiva">→</button>
</dialog>

<script>
  import { initGallery } from '../scripts/gallery';
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>

<style is:global>
  /* Colonne: stili in `styles/masonry.css` */
  .gallery__item {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    text-align: inherit;
  }

  /* Visore a tutto schermo */
  .viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--surface-inverse);
    color: var(--ink-inverse);
    overflow: hidden;
    /* Lo swipe orizzontale arriva alla pagina invece di essere assorbito dal browser */
    touch-action: pan-y pinch-zoom;
    -webkit-user-select: none;
    user-select: none;
  }
  .viewer:not([open]) { display: none; }
  .viewer__bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--page-pad);
  }
  .viewer__count { color: var(--ink-soft-inverse); }
  .viewer__button {
    min-height: 44px;
    padding: 0 var(--space-3);
    margin-right: calc(var(--space-3) * -1);
    border: 0;
    background: transparent;
    font-size: var(--fs-small);
    cursor: pointer;
  }
  .viewer__stage {
    position: absolute;
    inset: 72px 88px 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .viewer__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    -webkit-user-drag: none;
    user-select: none;
  }
  .viewer__placeholder { color: var(--ink-soft-inverse); text-align: center; }
  .viewer__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 56px;
    height: 56px;
    margin-top: -28px;
    border: 0;
    background: transparent;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }
  .viewer__nav--prev { left: var(--space-2); }
  .viewer__nav--next { right: var(--space-2); }
  .viewer__nav:disabled { opacity: 0.25; cursor: default; }
  @media (max-width: 640px) {
    .viewer__stage { inset: 64px 0 80px; }
    .viewer__nav { top: auto; bottom: var(--space-3); margin-top: 0; }
    .viewer__nav--prev { left: var(--page-pad); }
    .viewer__nav--next { right: var(--page-pad); }
  }
</style>
