---
import { getSiteSettings } from '../lib/content';
import { telHref } from '../lib/site';
import TextLink from './TextLink.astro';

/**
 * CTA di fine pagina: fascia nera a tutta larghezza, tutto centrato. La domanda è un link alla
 * pagina Contatti (senza sottolineatura).
 */
interface Props { question: string }
const { question } = Astro.props;
const settings = await getSiteSettings();
---
<section class="cta on-dark">
  <div class="container cta__inner">
    <p class="label cta__label">Parliamo del tuo progetto</p>
    <h2 class="h2 cta__question"><a href="/contatti" class="cta__link">{question}</a></h2>
    <div class="cta__side">
      <TextLink href="/contatti">Contatti</TextLink>
      <div class="cta__contacts">
        <a href={`mailto:${settings.email}`}>{settings.email}</a>
        <a href={telHref(settings.phone)}>{settings.phone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--surface-inverse); color: var(--ink-inverse); }
  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-9);
  }
  .cta__label { color: var(--ink-soft-inverse); margin-bottom: var(--space-4); }
  .cta__question { max-width: 18ch; }
  .cta__link { display: block; transition: opacity 0.2s ease; }
  .cta__link:hover { opacity: 0.75; }
  .cta__side { margin-top: var(--space-6); display: flex; flex-direction: column; align-items: center; }
  .cta__contacts { margin-top: var(--space-4); display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .cta__contacts a { font-size: var(--fs-link); color: var(--ink-soft-inverse); }

  @media (max-width: 640px) {
    .cta__inner { padding-block: var(--space-8); }
    .cta__side { margin-top: var(--space-5); }
    .cta__contacts a { display: inline-flex; align-items: center; min-height: 44px; }
    .cta__contacts { margin-top: var(--space-2); gap: 0; }
  }
</style>
