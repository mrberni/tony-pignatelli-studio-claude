---
import type { LogoClient } from '../lib/types';
import ClientLogo from './ClientLogo.astro';

/** Striscia "Brand & partner": il logo (un solo colore) dove esiste il file SVG, altrimenti il nome in testo. */
interface Props { clients: LogoClient[] }
const { clients } = Astro.props;
---
<section class="section section--bordered">
  <div class="container">
    <h2 class="label logos__label">Brand &amp; partner</h2>
    <ul class="logos">
      {clients.map((client) => (
        <li class="logos__item">
          {client.logoUrl ? (
            <ClientLogo client={{ ...client, logoUrl: client.logoUrl }} />
          ) : (
            <span class="logos__name">{client.name}</span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .logos__label { margin-bottom: var(--space-6); }
  .logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
  }
  .logos__item { display: flex; align-items: center; min-height: 52px; min-width: 0; }
  .logos__name { font-size: var(--fs-body); font-weight: 500; line-height: 1.3; }
  @media (max-width: 1023px) {
    .logos { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .logos { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4) var(--space-3); }
    .logos__item { min-height: 44px; }
  }
</style>
