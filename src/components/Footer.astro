---
import { getSiteSettings } from '../lib/content';
import { navItems } from '../lib/site';

interface Props { showBackToTop?: boolean }
const { showBackToTop = true } = Astro.props;
const settings = await getSiteSettings();
---
<footer class="site-footer on-dark">
  <div class="container">
    <div class="top">
      <a href="/" class="brand">{settings.studioName}</a>
      <nav aria-label="Footer" class="group">
        {navItems.map((item) => <a href={item.href} class="link">{item.label}</a>)}
      </nav>
      <div class="group">
        <a href={settings.instagramUrl} class="link" rel="noopener">Instagram</a>
        <a href={settings.linkedinUrl} class="link" rel="noopener">LinkedIn</a>
        <span class="link muted">Milano · Italia</span>
      </div>
    </div>
    <div class="bottom">
      <span class="meta muted">© 2026 {settings.studioName}</span>
      {showBackToTop ? <a href="#top" class="meta back">Torna su ↑</a> : <span></span>}
      <div class="legal">
        <a href="/privacy" class="meta muted">Privacy</a>
        <a href="/cookie" class="meta muted">Cookie</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* La linea che separa il footer dal CTA copre tutta la larghezza della finestra */
  .site-footer {
    background: var(--surface-inverse);
    color: var(--ink-inverse);
    border-top: 1px solid var(--line-inverse);
  }
  .top {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-4);
  }
  .brand { font-size: 17px; font-weight: 500; line-height: 1.2; }
  .group { display: flex; flex-wrap: wrap; gap: var(--space-5); }
  .link { font-size: var(--fs-small); font-weight: 400; line-height: 1.2; }
  .muted, .site-footer .meta.muted { color: var(--ink-soft-inverse); }
  .site-footer .meta { color: var(--ink-inverse); }
  .bottom {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
  }
  .legal { display: flex; gap: var(--space-4); justify-self: end; }

  @media (max-width: 640px) {
    .top { padding-top: var(--space-5); }
    .group { flex-direction: column; gap: 0; }
    .group .link, .back, .legal a { display: inline-flex; align-items: center; min-height: 44px; }
    /* "Torna su ↑" centrato su una riga propria, poi copyright, Privacy, Cookie */
    .bottom { grid-template-columns: 1fr; justify-items: start; gap: var(--space-1); }
    .back { justify-self: center; order: -1; }
    .legal { justify-self: start; gap: var(--space-3); }
  }
</style>
