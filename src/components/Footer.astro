---
import { siteName, navItems, social } from '../lib/site';

interface Props { showBackToTop?: boolean }
const { showBackToTop = true } = Astro.props;
---
<footer class="site-footer on-dark">
  <div class="container inner">
    <div class="top">
      <a href="/" class="brand">{siteName}</a>
      <nav aria-label="Footer" class="group">
        {navItems.map((item) => <a href={item.href} class="link">{item.label}</a>)}
      </nav>
      <div class="group">
        <a href={social.instagram} class="link" rel="noopener">Instagram</a>
        <a href={social.linkedin} class="link" rel="noopener">LinkedIn</a>
        <span class="link muted">Milano · Italia</span>
      </div>
    </div>
    <div class="bottom">
      <span class="meta muted">© 2026 {siteName}</span>
      {showBackToTop ? <a href="#top" class="meta back">Torna su ↑</a> : <span></span>}
      <div class="legal">
        <a href="/privacy" class="meta muted">Privacy</a>
        <a href="/cookie" class="meta muted">Cookie</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface-inverse); color: var(--ink-inverse); }
  .inner { border-top: 1px solid var(--line-inverse); }
  .top {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-4);
  }
  .brand { font-size: 17px; font-weight: 500; line-height: 1.2; }
  .group { display: flex; flex-wrap: wrap; gap: var(--space-5); }
  .link { font-size: var(--fs-small); font-weight: 400; line-height: 1.2; }
  .muted, .site-footer .meta.muted { color: var(--ink-soft-inverse); }
  .site-footer .meta { color: var(--ink-inverse); }
  .bottom {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
  }
  .legal { display: flex; gap: var(--space-4); justify-self: end; }
  @media (max-width: 640px) {
    .group { flex-direction: column; gap: var(--space-2); }
    .bottom { grid-template-columns: 1fr; justify-items: start; }
    .back { justify-self: center; order: -1; }
  }
</style>
