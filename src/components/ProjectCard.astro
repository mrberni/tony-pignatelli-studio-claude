---
import { metaLine } from '../lib/labels';
import type { ProjectSummary } from '../lib/types';
import Photo from './Photo.astro';

interface Props {
  project: ProjectSummary;
  /** Posizione nello schema della griglia sfalsata (1–8, a ciclo). */
  position?: number;
  /** Titolo da 22px in /progetti, 19px altrove. */
  size?: 'default' | 'large';
  loading?: 'eager' | 'lazy';
  sizes?: string;
}

const {
  project,
  position,
  size = 'default',
  loading = 'lazy',
  sizes = '(max-width: 640px) 100vw, (max-width: 1023px) 50vw, 40vw',
} = Astro.props;
---
<a
  href={`/progetti/${project.slug}`}
  class:list={['card', { 'card--large': size === 'large' }]}
  data-slot={position}
  data-category={project.category}
  data-sector={project.sector}
>
  <Photo photo={project.cover} fallbackAlt={project.title} loading={loading} sizes={sizes} />
  <div class="card__text">
    <div class="card__title">{project.title}</div>
    <div class="meta card__meta">{metaLine(project)}</div>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .card__title { font-size: var(--fs-body); font-weight: 500; line-height: 1.3; }
  .card--large .card__title { font-size: 22px; }
  .card__meta { margin-top: 4px; }
  @media (max-width: 640px) {
    .card--large .card__title { font-size: 20px; }
  }
</style>
