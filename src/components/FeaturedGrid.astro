---
import { layoutMasonry, MASONRY_COLUMNS } from '../lib/masonry';
import type { ProjectSummary } from '../lib/types';
import ProjectCard from './ProjectCard.astro';

/**
 * "Progetti selezionati" della home: 3 colonne della stessa larghezza (stile Pinterest),
 * foto con proporzioni diverse ritagliate attorno al punto focale. Disposizione in `lib/masonry.ts`,
 * stili in `styles/masonry.css`. Su telefono c'è una sola colonna.
 */
interface Props { projects: ProjectSummary[] }
const { projects } = Astro.props;

const slots = layoutMasonry(projects.length);
const columns = Array.from({ length: MASONRY_COLUMNS }, (_, column) =>
  slots.filter((slot) => slot.column === column).flatMap((slot) => {
    const project = projects[slot.index];
    return project ? [{ project, slot }] : [];
  }),
);
---
<div class="masonry">
  {columns.map((column) => (
    <div class="masonry__column">
      {column.map(({ project, slot }) => (
        <div style={`--ratio: ${slot.ratio}; order: ${slot.index}`}>
          <ProjectCard project={project} sizes="(max-width: 640px) 100vw, 34vw" />
        </div>
      ))}
    </div>
  ))}
</div>
