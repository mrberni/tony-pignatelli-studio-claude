---
import { siteName, navItems, isActive } from '../lib/site';

interface Props { currentPath: string }
const { currentPath } = Astro.props;
---
<header>
  <div class="container site-header">
    <a href="/" class="brand">{siteName}</a>
    <nav aria-label="Principale" class="nav">
      {navItems.map((item) => {
        const active = isActive(item.href, currentPath);
        return (
          <a
            href={item.href}
            class:list={['link', { 'is-active': active }]}
            aria-current={active ? 'page' : undefined}
          >{item.label}</a>
        );
      })}
    </nav>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 28px;
  }
  .brand { font-size: 17px; font-weight: 700; line-height: 1.2; }
  .nav { display: flex; align-items: center; gap: var(--space-5); }
  .link { font-size: var(--fs-small); font-weight: 400; line-height: 1.2; }
  .link.is-active { font-weight: 700; }

  /* Provvisorio: il pannello "Menu" a tutto schermo (HANDOFF §11.2) arriva in Fase 2. */
  @media (max-width: 640px) {
    .site-header { flex-direction: column; align-items: flex-start; gap: var(--space-3); padding-block: var(--space-4); }
    .nav { flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
    .link { padding-block: 12px; }
  }
</style>
