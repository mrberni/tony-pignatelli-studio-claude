---
import { getSiteSettings } from '../lib/content';
import { isActive, navItems } from '../lib/site';

interface Props { currentPath: string }
const { currentPath } = Astro.props;
const settings = await getSiteSettings();
---
<header>
  <div class="container site-header">
    <a href="/" class="brand">{settings.studioName}</a>
    <nav aria-label="Principale" class="nav">
      {navItems.map((item) => {
        const active = isActive(item.href, currentPath);
        return (
          <a
            href={item.href}
            class:list={['link', { 'is-active': active }]}
            aria-current={active ? 'page' : undefined}
          >{item.label}</a>
        );
      })}
    </nav>
    <button
      type="button"
      class="menu-button"
      data-menu-open
      aria-haspopup="dialog"
      aria-controls="menu-panel"
      aria-expanded="false"
    >Menu</button>
  </div>
</header>

<dialog id="menu-panel" class="menu-panel" aria-label="Menu">
  <div class="container menu-panel__inner">
    <div class="menu-panel__bar">
      <a href="/" class="brand">{settings.studioName}</a>
      <button type="button" class="menu-button menu-button--close" data-menu-close>Chiudi</button>
    </div>
    <nav aria-label="Menu principale" class="menu-panel__nav">
      {navItems.map((item) => {
        const active = isActive(item.href, currentPath);
        return (
          <a
            href={item.href}
            class:list={['menu-panel__link', 'h2', { 'is-active': active }]}
            aria-current={active ? 'page' : undefined}
          >{item.label}</a>
        );
      })}
    </nav>
    <div class="menu-panel__social">
      <a href={settings.instagramUrl} rel="noopener">Instagram</a>
      <a href={settings.linkedinUrl} rel="noopener">LinkedIn</a>
    </div>
  </div>
</dialog>

<script>
  import { initMenu } from '../scripts/menu';
  initMenu();
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 28px;
  }
  .brand { font-size: 17px; font-weight: 700; line-height: 1.2; }
  .nav { display: flex; align-items: center; gap: var(--space-5); }
  .link { font-size: var(--fs-small); font-weight: 400; line-height: 1.2; }
  .link.is-active { font-weight: 700; }

  /* Il pulsante "Menu" esiste solo su mobile (testo, non icona) */
  .menu-button {
    display: none;
    align-items: center;
    min-height: 44px;
    margin-right: calc(var(--space-3) * -1);
    padding: 0 var(--space-3);
    border: 0;
    background: transparent;
    font-size: var(--fs-small);
    font-weight: 400;
    line-height: 1.2;
    cursor: pointer;
  }

  .menu-panel {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--surface-100);
    color: var(--ink);
    overflow-y: auto;
  }
  .menu-panel:not([open]) { display: none; }
  .menu-panel__inner { min-height: 100%; display: flex; flex-direction: column; }
  .menu-panel__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
  }
  .menu-panel__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-7) var(--space-6);
  }
  .menu-panel__link { display: block; padding-block: var(--space-1); }
  .menu-panel__link.is-active { font-weight: 700; }
  .menu-panel__social {
    display: flex;
    gap: var(--space-5);
    margin-top: auto;
    padding-bottom: var(--space-6);
    font-size: var(--fs-small);
  }
  .menu-panel__social a { display: inline-flex; align-items: center; min-height: 44px; }

  @media (max-width: 640px) {
    .site-header { padding-block: var(--space-3); }
    .nav { display: none; }
    .menu-button { display: inline-flex; }
  }
</style>
