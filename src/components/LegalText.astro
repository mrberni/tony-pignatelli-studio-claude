---
/** Impaginazione dei testi legali (Privacy, Cookie): titolo, data di aggiornamento e testo in colonna di lettura. */
interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<div class="container legal">
  <h1 class="display">{title}</h1>
  <p class="meta legal__updated">Ultimo aggiornamento: {updated}</p>
  <div class="legal__body"><slot /></div>
</div>

<style>
  .legal { padding-block: var(--space-8) var(--space-9); }
  .legal__updated { margin-top: var(--space-4); }
  .legal__body { max-width: 720px; margin-top: var(--space-7); }
  .legal__body :global(h2) {
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 1.3;
    margin-top: var(--space-7);
  }
  .legal__body :global(p),
  .legal__body :global(ul) { margin-top: var(--space-3); line-height: 1.5; }
  .legal__body :global(ul) { padding-left: 1.25em; }
  .legal__body :global(li) { margin-top: var(--space-2); }
  .legal__body :global(a) { text-decoration: underline; text-underline-offset: 3px; }
</style>
