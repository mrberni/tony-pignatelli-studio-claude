---
import type { ClientEntry } from '../lib/types';

/** Elenco "Clienti" della pagina Studio: i nomi in testo, su 6 colonne (3 su tablet, 2 su telefono). */
interface Props { clients: ClientEntry[] }
const { clients } = Astro.props;
---
<ul class="clients">
  {clients.map((client) => (
    <li>{client.name}</li>
  ))}
</ul>

<style>
  .clients {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-4);
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  @media (max-width: 1023px) {
    .clients { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .clients { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
