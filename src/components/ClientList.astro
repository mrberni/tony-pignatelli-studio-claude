---
import type { LogoClient } from '../lib/types';
import ClientLogo from './ClientLogo.astro';

/** Elenco clienti: il logo (un solo colore) dove esiste l'SVG, altrimenti il nome in testo. */
interface Props { clients: LogoClient[] }
const { clients } = Astro.props;
---
<ul class="clients">
  {clients.map((client) => (
    <li class="clients__item">
      {client.logoUrl ? <ClientLogo client={{ ...client, logoUrl: client.logoUrl }} /> : <span>{client.name}</span>}
    </li>
  ))}
</ul>

<style>
  .clients {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .clients__item { display: flex; align-items: center; min-height: 52px; min-width: 0; }
  @media (max-width: 1023px) {
    .clients { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .clients { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4) var(--space-3); }
    .clients__item { min-height: 44px; }
  }
</style>
