---
import type { ClientEntry } from '../lib/types';

/**
 * Elenco "Clienti" della pagina Studio: i nomi in testo, su 6 colonne (3 su tablet, 2 su telefono).
 * L'ordine alfabetico scende lungo le colonne (come un elenco), non lungo le righe.
 */
interface Props { clients: ClientEntry[] }
const { clients } = Astro.props;
---
<ul class="clients">
  {clients.map((client) => (
    <li>{client.name}</li>
  ))}
</ul>

<style>
  .clients {
    list-style: none;
    margin: 0;
    padding: 0;
    column-count: 6;
    column-gap: var(--space-4);
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .clients li { break-inside: avoid; padding-bottom: var(--space-4); }
  @media (max-width: 1023px) {
    .clients { column-count: 3; }
  }
  @media (max-width: 640px) {
    .clients { column-count: 2; }
  }
</style>
