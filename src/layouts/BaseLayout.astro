---
import '../styles/global.css';
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-500.css';
import '@fontsource/hanken-grotesk/latin-700.css';
import font400 from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url';
import font500 from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-500-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings } from '../lib/content';
import { isSanityConfigured, sanityDataset } from '../lib/sanity';

interface Props {
  title?: string;
  description?: string;
  /** Immagine Open Graph (URL assoluto). */
  image?: string;
  showBackToTop?: boolean;
  /** Dati strutturati (JSON-LD). */
  jsonLd?: Record<string, unknown>;
  /** Pagine segnaposto: non vanno indicizzate. */
  noindex?: boolean;
}
const settings = await getSiteSettings();
const {
  title = settings.defaultSeo.title,
  description = settings.defaultSeo.description,
  image,
  showBackToTop = true,
  jsonLd,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Da dove arrivano i contenuti di questo build (utile per capire se un'anteprima legge Sanity o i dati di prova) -->
    <meta name="content-source" content={isSanityConfigured ? `sanity:${sanityDataset}` : 'fixtures'} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={settings.studioName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font500} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body id="top">
    <a href="#main" class="skip-link">Vai al contenuto</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main"><slot /></main>
    <Footer showBackToTop={showBackToTop} />
  </body>
</html>
