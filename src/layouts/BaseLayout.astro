---
import '../styles/global.css';
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-500.css';
import '@fontsource/hanken-grotesk/latin-700.css';
import font400 from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url';
import font500 from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-500-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteName } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  showBackToTop?: boolean;
}
const { title = siteName, description, showBackToTop = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font500} as="font" type="font/woff2" crossorigin />
  </head>
  <body id="top">
    <a href="#main" class="skip-link">Vai al contenuto</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main"><slot /></main>
    <Footer showBackToTop={showBackToTop} />
  </body>
</html>
