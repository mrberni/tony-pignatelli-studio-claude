---
import Cta from '../../components/Cta.astro';
import Gallery from '../../components/Gallery.astro';
import Photo from '../../components/Photo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNeighbors, getProjects, getSiteSettings } from '../../lib/content';
import { sizedUrl } from '../../lib/image';
import { metaLine } from '../../lib/labels';
import type { Project, ProjectSummary } from '../../lib/types';

export async function getStaticPaths() {
  const projects = await getProjects();
  return Promise.all(
    projects.map(async (project) => ({
      params: { slug: project.slug },
      props: { project, neighbors: await getNeighbors(project) },
    })),
  );
}

interface Props {
  project: Project;
  neighbors: { previous?: ProjectSummary; next?: ProjectSummary };
}
const { project, neighbors } = Astro.props;
const settings = await getSiteSettings();

// Titolo, descrizione e immagine social: SEO del progetto se c'è, altrimenti titolo, frase di apertura e copertina
const pageTitle = `${project.seo?.title ?? project.title} — ${settings.studioName}`;
const description = project.seo?.description ?? project.intro ?? settings.defaultSeo.description;
const ogImage = project.seo?.imageUrl ?? (project.cover.src ? sizedUrl(project.cover.src, 1200) : undefined);

// Paragrafi separati da una riga vuota
const paragraphs = (project.description ?? '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

const info = [
  { label: 'Cliente', values: [project.client] },
  ...(project.city ? [{ label: 'Luogo', values: [project.city] }] : []),
  ...(project.services.length > 0 ? [{ label: 'Servizi', values: project.services }] : []),
];
---
<BaseLayout title={pageTitle} description={description} {...(ogImage ? { image: ogImage } : {})}>
  <div class="container head grid12">
    <a href="/progetti" class="label head__back">← Progetti</a>
    <div class="head__title">
      <p class="meta head__meta">{metaLine(project)}</p>
      <h1 class="display">{project.title}</h1>
    </div>
  </div>

  <div class="container cover">
    <Photo
      photo={project.cover}
      fallbackAlt={project.title}
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
    />
  </div>

  <section class="container about grid12" aria-labelledby="about-label">
    <h2 class="label about__label" id="about-label">Il progetto</h2>
    <div class="about__text">
      {project.intro && <p class="lead">{project.intro}</p>}
      {paragraphs.length > 0 && (
        <div class="about__description prose-soft">
          {paragraphs.map((text) => <p>{text}</p>)}
        </div>
      )}
    </div>
    <dl class="about__info">
      {info.map((row) => (
        <div class="about__row">
          <dt class="meta">{row.label}</dt>
          <dd>{row.values.map((value) => <div>{value}</div>)}</dd>
        </div>
      ))}
    </dl>
  </section>

  {project.gallery.length > 0 && (
    <section class="container gallery-section" aria-labelledby="gallery-label">
      <h2 class="label gallery-section__label" id="gallery-label">Galleria</h2>
      <Gallery photos={project.gallery} fallbackAlt={project.title} />
    </section>
  )}

  {(neighbors.previous || neighbors.next) && (
    <nav class="section--bordered neighbors" aria-label="Altri progetti">
      <div class="container grid12 neighbors__grid">
        {neighbors.previous && (
          <a href={`/progetti/${neighbors.previous.slug}`} class="neighbors__link neighbors__link--prev" rel="prev">
            <span class="label neighbors__label">← Precedente</span>
            <span class="lead neighbors__title">{neighbors.previous.title}</span>
            <span class="meta neighbors__meta">{metaLine(neighbors.previous)}</span>
          </a>
        )}
        {neighbors.next && (
          <a href={`/progetti/${neighbors.next.slug}`} class="neighbors__link neighbors__link--next" rel="next">
            <span class="label neighbors__label">Successivo →</span>
            <span class="lead neighbors__title">{neighbors.next.title}</span>
            <span class="meta neighbors__meta">{metaLine(neighbors.next)}</span>
          </a>
        )}
      </div>
    </nav>
  )}

  <Cta question={settings.projectCtaQuestion} />
</BaseLayout>

<style>
  .head { padding-top: var(--space-5); padding-bottom: var(--space-7); }
  .head__back { grid-column: 1 / 4; color: var(--ink); align-self: start; }
  .head__title { grid-column: 4 / 13; }
  .head__meta { margin-bottom: var(--space-4); }

  /* Copertina 16:9; su telefono 4:3, per restare ben visibile (HANDOFF §11.4) */
  .cover { padding-bottom: var(--space-8); }
  .cover :global(.photo) { --ratio: 16 / 9; }

  .about { padding-bottom: var(--space-9); align-items: start; }
  .about__label { grid-column: 1 / 4; }
  .about__text { grid-column: 4 / 10; }
  .about__description { margin-top: var(--space-5); }
  .about__description p + p { margin-top: var(--space-4); }
  .about__info { grid-column: 10 / 13; margin: 0; }
  .about__row { border-top: 1px solid var(--line); padding-block: var(--space-3); }
  .about__row:last-child { border-bottom: 1px solid var(--line); }
  .about__row dt { margin-bottom: 4px; }
  .about__row dd { margin: 0; }

  .gallery-section { padding-bottom: var(--space-9); }
  .gallery-section__label { margin-bottom: var(--space-6); }

  .neighbors { padding-block: var(--space-7) var(--space-9); }
  .neighbors__link { display: block; min-width: 0; }
  .neighbors__link--prev { grid-column: 1 / 7; }
  .neighbors__link--next { grid-column: 7 / 13; text-align: right; }
  .neighbors__label { display: block; margin-bottom: var(--space-3); }
  .neighbors__title { display: block; max-width: 18ch; line-height: 1.15; }
  .neighbors__link--next .neighbors__title { margin-left: auto; }
  .neighbors__meta { display: block; margin-top: var(--space-2); }

  @media (max-width: 1023px) {
    .head__back { grid-column: 1 / -1; margin-bottom: var(--space-4); }
    .head__title { grid-column: 1 / -1; }
    .about__label { grid-column: 1 / -1; margin-bottom: var(--space-3); }
    .about__text { grid-column: 1 / -1; }
    .about__info { grid-column: 1 / -1; margin-top: var(--space-6); }
  }
  @media (max-width: 640px) {
    .head { padding-top: var(--space-4); padding-bottom: var(--space-6); }
    .cover { padding-bottom: var(--space-7); }
    .cover :global(.photo) { --ratio: 4 / 3; }
    .about { padding-bottom: var(--space-8); }
    .gallery-section { padding-bottom: var(--space-8); }
    .gallery-section__label { margin-bottom: var(--space-5); }
    .neighbors { padding-block: var(--space-6) var(--space-8); }
    /* "Precedente" e "Successivo" uno sotto l'altro, separati da un filetto */
    .neighbors__link--prev, .neighbors__link--next { grid-column: 1 / -1; text-align: left; }
    .neighbors__link--next { margin-top: var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--line); }
    .neighbors__link--next .neighbors__title { margin-left: 0; }
  }
</style>
