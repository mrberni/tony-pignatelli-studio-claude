---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<!-- Pagina segnaposto: il testo legale lo fornisce l'utente (HANDOFF §5, §13.6) -->
<BaseLayout title="Privacy — Tony Pignatelli Studio" noindex>
  <div class="container legal">
    <h1 class="display">Privacy</h1>
    <p class="prose-soft">Il testo di questa pagina è in preparazione.</p>
  </div>
</BaseLayout>

<style>
  .legal { padding-block: var(--space-8) var(--space-9); }
  .legal p { margin-top: var(--space-4); }
</style>
