---
import Cta from '../components/Cta.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServicesPage, getSiteSettings } from '../lib/content';

const [settings, page] = await Promise.all([getSiteSettings(), getServicesPage()]);

const title = `${page.seo?.title ?? 'Servizi'} — ${settings.studioName}`;
const description = page.seo?.description ?? page.intro;
const number = (i: number) => String(i + 1).padStart(2, '0');
---
<BaseLayout title={title} description={description}>
  <section class="container grid12 intro">
    <p class="label intro__label">Servizi</p>
    <h1 class="h2 intro__title">{page.intro}</h1>
  </section>

  <div class="container">
    <ol class="services">
      {page.services.map((service, i) => (
        <li class="service grid12">
          <span class="label service__number">{number(i)}</span>
          <h2 class="h2 service__title">{service.title}</h2>
          <p class="prose-soft service__text">{service.description}</p>
        </li>
      ))}
    </ol>
  </div>

  <section class="container section collab">
    <h2 class="h2 collab__title">{page.collaboration.title}</h2>
    <p class="prose-soft collab__intro">{page.collaboration.intro}</p>
    <ul class="roles">
      {page.collaboration.roles.map((role) => (
        <li class="roles__item">
          <h3 class="roles__name">{role.title}</h3>
          <p class="prose-soft roles__text">{role.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <Cta question={page.ctaQuestion} />
</BaseLayout>

<style>
  .intro { padding-top: var(--space-7); padding-bottom: var(--space-8); }
  .intro__label { grid-column: 1 / 4; }
  .intro__title { grid-column: 4 / 13; max-width: 22ch; }

  /* Quattro servizi numerati: filetto sopra ogni riga e uno di chiusura dopo l'ultimo */
  .services { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .service {
    border-top: 1px solid var(--line);
    padding-block: var(--space-5) var(--space-6);
    align-items: start;
  }
  .service__number { grid-column: 1 / 3; }
  .service__title { grid-column: 3 / 8; font-size: var(--fs-h3); }
  .service__text { grid-column: 8 / 13; max-width: none; }

  .collab__title { margin-bottom: var(--space-4); }
  .collab__intro { margin-bottom: var(--space-7); }
  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .roles__item { padding-inline: var(--space-5); border-left: 1px solid var(--line); }
  .roles__item:first-child { padding-left: 0; border-left: 0; }
  .roles__item:last-child { padding-right: 0; }
  .roles__name { font-size: var(--fs-body); font-weight: 500; line-height: 1.3; margin-bottom: var(--space-2); }
  .roles__text { line-height: 1.6; max-width: none; }

  @media (max-width: 1023px) {
    .intro__label { grid-column: 1 / -1; margin-bottom: var(--space-3); }
    .intro__title { grid-column: 1 / -1; }
    .service__number { grid-column: 1 / 3; }
    .service__title { grid-column: 3 / -1; }
    .service__text { grid-column: 3 / -1; margin-top: var(--space-3); }
    /* 2 colonne: filetti orizzontali al posto di quelli verticali */
    .roles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-5); }
    .roles__item,
    .roles__item:first-child,
    .roles__item:last-child { padding: var(--space-4) 0 var(--space-5); border-left: 0; border-top: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    .intro { padding-top: var(--space-5); padding-bottom: var(--space-7); }
    /* I quattro servizi impilati: numero, titolo, descrizione */
    .service { padding-block: var(--space-4) var(--space-5); }
    .service__number { grid-column: 1 / -1; margin-bottom: var(--space-2); }
    .service__title, .service__text { grid-column: 1 / -1; }
    .collab__intro { margin-bottom: var(--space-6); }
    .roles { grid-template-columns: minmax(0, 1fr); }
  }
</style>
