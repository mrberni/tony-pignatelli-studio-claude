---
import Cta from '../components/Cta.astro';
import Hero from '../components/Hero.astro';
import BrandStrip from '../components/BrandStrip.astro';
import ProjectList from '../components/ProjectList.astro';
import SectionTLC from '../components/SectionTLC.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomePage, getStripClients, getSiteSettings } from '../lib/content';
import { telHref } from '../lib/site';

const [settings, home, clients] = await Promise.all([getSiteSettings(), getHomePage(), getStripClients()]);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.studioName,
  url: new URL('/', Astro.site).href,
  email: settings.email,
  telephone: telHref(settings.phone).replace('tel:', ''),
  address: settings.address,
  sameAs: [settings.instagramUrl, settings.linkedinUrl],
};
---
<BaseLayout jsonLd={organization}>
  <Hero slides={home.carousel} />

  <SectionTLC
    label="Lo studio"
    title={home.studioSection.title}
    text={home.studioSection.text}
    href="/studio"
    linkLabel="Conosci lo studio"
  />

  <ProjectList />

  <SectionTLC
    bordered
    label="Servizi"
    title={home.servicesSection.title}
    text={home.servicesSection.text}
    href="/servizi"
    linkLabel="Scopri i servizi"
  />

  <BrandStrip clients={clients} />

  <Cta question={home.ctaQuestion} />
</BaseLayout>

